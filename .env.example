# Copy to .env and fill in your values (never commit .env).
LLM_API_KEY=your-api-key
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-flash
TAVILY_API_KEY=your-tavily-key
OPENCODE_API_KEY=your-opencode-key

# Optional: where the host finds the downstream agents (defaults shown)
# CHAT_AGENT_URL=http://127.0.0.1:9999
# SEARCH_AGENT_URL=http://127.0.0.1:9997

# Optional: decision model the host routes with (default shown)
# A2A_POC_DECISION_MODEL=gemini-decision-1
